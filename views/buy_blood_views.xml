<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="buy_blood_view_form" model="ir.ui.view">
        <field name="name">buy.blood.view.form</field>
        <field name="model">buy.blood</field>
        <field name="arch" type="xml">
            <form string="Blood Buy">
                <header>
                    <button string="Cancel" name="action_cancel" type="object" invisible = "state in ['confirmed','cancel']"/>

                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed"/>
                </header>
                <sheet>
                    <field name="take_more" invisible="1"/>
                    <group>
                        <group>
                            <field name="donor_id" readonly="state in ['confirmed','cancel']"/>
                            <field name="date" readonly="state in ['confirmed','cancel']"/>
                        </group>
                        <group>
                            <field name="product_id" readonly="state in ['confirmed','cancel']"/>
                            <field name="qty"  invisible ="product_id == False" readonly="state in ['confirmed','cancel']"/>
                        </group>
                        <field name="order_request_ids" readonly="1" force_save="1" required="1" invisible ="product_id == False" >
                            <list edit="false" create="false">
                                <field name="date" />
                                <field name="provider_id"/>
                                <field name="balance"/>
                                <field name="product_id"/>
                                <field name="qty"/>
                                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'accept'"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="buy_blood_view_tree" model="ir.ui.view">
        <field name="name">buy.blood.view.list</field>
        <field name="model">buy.blood</field>
        <field name="arch" type="xml">
            <list string="Buy Blood">
                <field name="donor_id" />
                <field name="date"/>
                <field name="product_id"/>
                <field name="qty"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'confirmed'"/>
            </list>
        </field>
    </record>

    <record id="action_buy_blood" model="ir.actions.act_window">
        <field name="name">Buy Blood</field>
        <field name="res_model">buy.blood</field>
        <field name="binding_view_types">form</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="buy_blood_menu" parent="healthcare_management.menu_blood_blood" action="action_buy_blood" name="Buy Blood" sequence="30"/>
</odoo>