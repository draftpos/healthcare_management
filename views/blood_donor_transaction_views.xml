<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="blood_donor_transaction_view_form" model="ir.ui.view">
        <field name="name">blood.donor.transaction.view.form</field>
        <field name="model">blood.donor.transaction</field>
        <field name="arch" type="xml">
            <form string="Blood Transaction" create="false">
                <sheet>
                    <group>
                        <group>
                            <field name="donor_id" readonly="1" />
                            <field name="type" readonly="1"/>
                            <field name="date" readonly="1"/>
                        </group>
                        <group>
                            <field name="product_id" readonly="1"/>
                            <field name="qty" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="blood_donor_transaction_view_tree" model="ir.ui.view">
        <field name="name">blood.donor.transaction.view.list</field>
        <field name="model">blood.donor.transaction</field>
        <field name="arch" type="xml">
            <list string="Blood Transactions" create="false">
                <field name="donor_id"/>
                <field name="type"/>
                <field name="date"/>
                <field name="product_id"/>
                <field name="qty" sum="total"/>
            </list>
        </field>
    </record>

    <record id="action_blood_donor_transaction" model="ir.actions.act_window">
        <field name="name">Blood Transaction</field>
        <field name="res_model">blood.donor.transaction</field>
        <field name="binding_view_types">form</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="blood_donor_transaction_menu" parent="healthcare_management.menu_blood_blood" action="action_blood_donor_transaction" name="Blood Transaction" sequence="20"/>
</odoo>