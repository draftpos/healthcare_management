<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="medical_inpatient_icu_form_view" model="ir.ui.view">
        <field name="name">medical.inpatient.icu.form.view</field>
        <field name="model">medical.inpatient.icu</field>
        <field name="arch" type="xml">
            <form string="Patient ICU Info">
                <header>
                    <button string="Admit" invisible = "state != 'draft'" class="oe_highlight" name="action_admit" type="object"/>
                    <button string="Discharge" invisible = "state != 'admit'" class="oe_highlight" name="action_discharge" type="object"/>
                    <button string="Cancel" invisible = "state != 'draft'" name="action_cancel" type="object"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,admit,dicharge"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="medical_inpatient_registration_id"/>
                            <field name="admitted" invisible="1"/>
                        </group>
                        <group>
                            <field name="icu_admission_date"/>
                            <field name="icu_stay" />
                            <field name="deceased"/>
                        </group>
                        <group>
                            <field name="discharged_from_icu" invisible="1"/>
                            <field name="icu_discharge_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page autofocus="autofocus" string="Mechanical Ventilation History">
                            <form>
                                <field name="medical_icu_ventilation_ids">
                                    <list>
                                        <field name="current_mv" />
                                        <field name="mv_start" />
                                        <field name="mv_period" />
                                        <field name="ventilation" />
                                        <field name="remarks" />
                                    </list>
                                </field>
                            </form>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="medical_inpatient_icu_tree_view" model="ir.ui.view">
        <field name="name">medical.inpatient.icu.list.view</field>
        <field name="model">medical.inpatient.icu</field>
        <field name="arch" type="xml">
            <list string="Patient ICU Info">
                <field name="medical_inpatient_registration_id" />
                <field name="admitted" />
                <field name="icu_admission_date" />
                <field name="icu_stay" />
                <field name="discharged_from_icu" />
                <field name="icu_discharge_date" />
            </list>
        </field>
    </record>

    <record id="action_medical_inpatient_icu" model="ir.actions.act_window">
        <field name="name">Patient ICU Info</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">medical.inpatient.icu</field>
        <field name="binding_view_types">form</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_medical_inpatient_icu_form" action="action_medical_inpatient_icu" sequence="4" parent="menu_intensive_care" />

</odoo>
