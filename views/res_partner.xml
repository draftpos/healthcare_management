<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_partner_inherit_form_health_center_view" model="ir.ui.view">
        <field name="name">res.partner.inherit.form.health.center.view</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <field name="function" position="after">
                <field name="relationship" />
                <field name="relative_partner_id" />
            </field>
            <notebook>
                <page string="Medical">
                    <group>
                        <group>
                            <field name="is_patient" />
                            <field name="is_doctor" />
                            <field name="is_institution" />
                        </group>
                        <group>
                            <field name="is_insurance_company" />
                            <field name="is_pharmacy" />
                        </group>
                    </group>
                    <field name="company_insurance_ids" colspan="4"  invisible=" is_company == False"/> 
                    <field name="patient_insurance_ids" colspan="4"  invisible=" is_company == True" />
                </page>
            </notebook>
        </field>
    </record>

    <record id="res_partner_view_tree_ineherit_hospital" model="ir.ui.view">
        <field name="name">res.partner.view.list.inehrit.hospital</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree"/>
        <field name="arch" type="xml">
            <field name="user_id" position="after">
                <field name="is_institution"/>
            </field>
        </field>
    </record>

    <record model="ir.actions.act_window" id="act_res_partner">
        <field name="name">Insurances Company</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.partner</field>
        <field name="binding_view_types">form</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_insurance_company','=',1)]</field>
        <field name="context">{"default_is_insurance_company":1,"search_default_is_insurance_company":1}
        </field>
    </record>

    <record id="action_health_center_owners_code" model="ir.actions.act_window">
        <field name="name">Health Center</field>
        <field name="res_model">res.partner</field>
        <field name="binding_view_types">form</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_institution','=',True)]</field>
    </record>

    <menuitem id="menu_health_centers1" name="Health Centers" parent="main_menu_configartion" />

    <menuitem id="menu_insurance" name="Insurances" parent="main_menu_configartion" sequence='9' />
    <menuitem id="menu_insurance_company" action="act_res_partner" sequence="0" parent="menu_insurance" />
    <menuitem id="health_center_main" action="healthcare_management.action_health_center_owners_code" parent="menu_health_centers" sequence="2" />


</odoo>
