<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="medical_health_service_form_view" model="ir.ui.view">
        <field name="name">medical.health_service.form.view</field>
        <field name="model">medical.health_service</field>
        <field name="arch" type="xml">
            <form string="Service">
                <header>
                    <button name="button_set_to_confirm" string="Confirm" invisible = "state != 'draft'" type="object" />
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed" />
                </header>
                <group>
                    <group>
                        <field name="name" />
                        <field name="description" />
                    </group>
                    <group>
                        <field name="patient_id"/>
                        <field name="service_date" />
                    </group>
                    <field name="service_line_ids" nolabel="1" colspan="8">
                        <list>
                            <field name="to_invoice" />
                            <field name="description" />
                            <field name="product_id" />
                            <field name="qty" />
                            <field name="from_date" />
                            <field name="to_date" />
                        </list>
                    </field>
                </group>
            </form>
        </field>
    </record>

    <record id="medical_health_service_tree_view" model="ir.ui.view">
        <field name="name">medical.health_service.list.view</field>
        <field name="model">medical.health_service</field>
        <field name="arch" type="xml">
            <list string="Service">
                <field name="name" />
                <field name="description" />
                <field name="patient_id" />
                <field name="service_date" />
                <field name="state" />
            </list>
        </field>
    </record>

    <record id="action_medical_health_service" model="ir.actions.act_window">
        <field name="name">Medical Service</field>
        <field name="res_model">medical.health_service</field>
        <field name="binding_view_types">form</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_health_service" action="action_medical_health_service" parent="menu_medical_health_service" sequence="1" />
</odoo>
