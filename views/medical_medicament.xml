<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="medical_action_tree_medicament_reporting" model="ir.actions.act_window">
        <field name="name">Medicament List</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">medical.medicament</field>
        <field name="binding_view_types">form</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="medical_medicament_form_view" model="ir.ui.view">
        <field name="name">medical.medicament.form.view</field>
        <field name="model">medical.medicament</field>
        <field name="arch" type="xml">
            <form string="medicaments">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" default_focus="1" placeholder="e.g. Peracitamol"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="product_id" readonly="1" context="{'default_is_medicament': 1, 'search_default_is_medicament': 1,'search_default_type': 'service','default_type': 'service'}" />
                            <field name="category_id" />
                            <field name="therapeutic_action" />
                            <field name="active_component" />
                        </group>
                        <group>
                            <field name="price" />
                            <field name="qty_available" />
                            <field name="expiry_date"/>
                            <field name="indications"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Presentation">
                            <field name="presentation" />
                        </page>
                        <page string="Composition">
                            <field name="composition" />
                        </page>
                        <page string="Dosage">
                            <group colspan="4" col="4">
                                <field name="dosage" />
                                <field name="overdosage" />
                            </group>
                        </page>
                        <page string="Pregnancy / Lactancy">
                            <group colspan="4" col="4">
                                <field name="pregnancy_warning" />
                                <field name="pregnancy_category" />
                                <field name="pregnancy" />
                            </group>
                        </page>

                        <page string="Adverse Reactions">
                            <field name="adverse_reaction" />
                        </page>

                        <page string="Storage Conditions">
                            <field name="storage" />
                        </page>

                        <page string="Extra Info">
                            <field name="notes" />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="medical_medicament_tree_view" model="ir.ui.view">
        <field name="name">medical.medicament.list.view</field>
        <field name="model">medical.medicament</field>
        <field name="arch" type="xml">
            <list string="medicament">
                <field name="product_id" />
                <field name="active_component" />
                <field name="category_id" />
                <field name="qty_available" />
                <field name="therapeutic_action" />
                <field name="pregnancy_warning" />
                <field name="price" />
            </list>
        </field>
    </record>

    <record id="action_medical_medicament" model="ir.actions.act_window">
        <field name="name">Medicaments</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">medical.medicament</field>
        <field name="binding_view_types">form</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_medical_medicament_reporting" action="medical_action_tree_medicament_reporting" parent="menu_reporting" sequence="0"/>

    <menuitem id="menu_medicament" name="Medicaments" parent="main_menu_configartion" sequence="8" />
    <menuitem id="menu_sub_medicament" action="action_medical_medicament" sequence="0" parent="menu_misc" />

</odoo>
