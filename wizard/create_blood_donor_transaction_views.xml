<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="create_blood_donor_transaction_view_form" model="ir.ui.view">
        <field name="name">create.blood.donor.transaction.view.form</field>
        <field name="model">create.blood.donor.transaction</field>
        <field name="arch" type="xml">
            <form string="">
                <sheet>
                    <group>
                        <group>
                            <field name="donor_id"/>
                            <field name="type" readonly="1"/>
                            <field name="date"/>
                        </group>
                        <group>
                            <field name="product_id"/>
                            <field name="qty" invisible="product_id == False"/>
                            <field name="more_buy" invisible="1"/>

                        </group>
                    </group>
                    <div class="alert alert-warning alert-dismissible fade show" style="padding-bottom:20px;" role="alert" invisible="more_buy != True">
                        <strong>Not sufficient Blood! You need to buy if you want.</strong>
                    </div>
                </sheet>
                <footer>
                    <button name="action_create_blood_donor_transaction" class="oe_highlight" string="Confirm Transaction" invisible="more_buy == True" type="object"/>
                    <button name="action_create_blood_donor_transaction" class="oe_highlight" string="Confirm and Create Buy Request" context="{'buy_more_req': True}" invisible="more_buy != True" type="object"/>
                    <button special="cancel" string="Cancel" class="oe_highlight"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>