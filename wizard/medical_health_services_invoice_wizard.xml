<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="medical_health_service_invoice_wizard_view" model="ir.ui.view">
        <field name="name">medical.health.service.invoice.wizard.view
        </field>
        <field name="model">medical.health.service.invoice</field>
        <field name="arch" type="xml">
            <form string="Create Invoice">
                <separator colspan="4" string="Do you want to generate the Invoice(s) ?" />
                <newline />
                <separator string="Create Invoice" colspan="6" />
                <footer>
                    <button name="create_medical_service_invoice" string="Create Invoice" type="object" class="oe_highlight" />
                    <button special="cancel" string="Cancel" class="oe_highlight" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_medical_health_service_invoice_wizard" model="ir.actions.act_window">
        <field name="name">Create Invoice</field>
        <field name="res_model">medical.health.service.invoice</field>
        <field name="binding_model_id" ref="model_medical_health_service"/>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>